name = "isco-telegram-control"
main = "index.js"
compatibility_date = "2026-08-26"
workers_dev = true

[vars]
GITHUB_REPO = "mymusa79-tech/Isco-Video-Runner"
GITHUB_REF = "main"
YOUTUBE_CHANNEL_ID = "UC_fmWGRen6QUQNd4Dj80MgA"

# Secrets are intentionally NOT stored in this file.
# Configure at deployment time:
#   TELEGRAM_BOT_TOKEN
#   TELEGRAM_WEBHOOK_SECRET
#   TELEGRAM_ALLOWED_USER_ID
#   TELEGRAM_CHAT_ID
#   GITHUB_CONTROL_TOKEN   (minimum permission needed to dispatch the editorial workflow)
#   YOUTUBE_API_KEY
