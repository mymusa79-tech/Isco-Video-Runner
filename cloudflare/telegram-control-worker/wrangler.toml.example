name = "isco-telegram-control"
main = "observability-worker.js"
compatibility_date = "2026-08-26"
workers_dev = true

# ZERO_COST_MODE intentionally omits a [limits] block. Cloudflare Workers Free
# enforces its own plan ceilings (including 10 ms CPU, 50 external subrequests,
# and 100,000 requests/day). Cloudflare rejects configurable CPU limits on the
# Free plan, so adding cpu_ms here would incorrectly require a paid plan.
# The Worker also uses no KV, D1, R2, Durable Objects, Queues, Workflows,
# Analytics Engine, paid routes, or other billable Cloudflare bindings.

[vars]
GITHUB_REPO = "mymusa79-tech/Isco-Video-Runner"
GITHUB_REF = "main"
YOUTUBE_CHANNEL_ID = "UC_fmWGRen6QUQNd4Dj80MgA"
ZERO_COST_MODE = "true"

# Secrets are intentionally NOT stored in this file.
# Configure at deployment time:
#   TELEGRAM_BOT_TOKEN
#   TELEGRAM_WEBHOOK_SECRET
#   TELEGRAM_ALLOWED_USER_ID
#   TELEGRAM_CHAT_ID
#   GITHUB_CONTROL_TOKEN   (repo-scoped fine-grained token; Actions: write only)
#   YOUTUBE_API_KEY
